{
  "Download": {
    "MaxConnections": 4,
    "MaxParallelFiles": 1,
    "MinSizeForMultiThread": 1048576,
    "ConnectTimeoutSeconds": 30,
    "ReadIdleTimeoutSeconds": 60,
    "MaxRetries": 3,
    "RetryDelaySeconds": 2,
    "UserAgent": "SuDown/2.0",
    "EnableResume": true,
    "EnableMultiThread": true
  },
  "Proxy": {
    "Enabled": false,
    "Address": "http://127.0.0.1:7890",
    "Username": "",
    "Password": ""
  },
  "Request": {
    "Headers": {},
    "Auth": "",
    "AuthType": "",
    "Session": "",
    "UseNetrc": true,
    "Verbose": false,
    "MaxRedirects": 10
  }
}
